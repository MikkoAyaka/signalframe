{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "lib",
    "rootDir": "src/design-system",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/design-system/**/*.ts", "src/design-system/**/*.tsx"]
}
